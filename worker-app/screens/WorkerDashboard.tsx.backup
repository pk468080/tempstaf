import { createClient } from 'https://esm.sh/@supabase/supabase-js'

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers':
    'authorization, x-client-info, apikey, content-type',
  'Access-Control-Allow-Methods':
    'POST, OPTIONS',
}

async function sha256(value: string): Promise<string> {
  const data = new TextEncoder().encode(value)

  const hash = await crypto.subtle.digest(
    'SHA-256',
    data
  )

  return Array.from(new Uint8Array(hash))
    .map(byte =>
      byte.toString(16).padStart(2, '0')
    )
    .join('')
}

Deno.serve(async req => {
  /*
   * CORS
   */
  if (req.method === 'OPTIONS') {
    return new Response('ok', {
      headers: corsHeaders,
    })
  }

  /*
   * Only POST is allowed.
   */
  if (req.method !== 'POST') {
    return new Response(
      JSON.stringify({
        error: 'Method not allowed.',
      }),
      {
        status: 405,
        headers: {
          ...corsHeaders,
          'Content-Type': 'application/json',
        },
      }
    )
  }

  try {
    /*
     * ---------------------------------------------------------
     * ENVIRONMENT
     * ---------------------------------------------------------
     */

    const supabaseUrl =
      Deno.env.get('SUPABASE_URL')

    const serviceRoleKey =
      Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')

    if (!supabaseUrl || !serviceRoleKey) {
      console.error(
        '[verify-booking-otp] Missing Supabase environment variables.'
      )

      return new Response(
        JSON.stringify({
          error:
            'Server configuration error.',
        }),
        {
          status: 500,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * AUTHORIZATION
     * ---------------------------------------------------------
     */

    const authHeader =
      req.headers.get('Authorization')

    if (!authHeader) {
      return new Response(
        JSON.stringify({
          error:
            'Authorization header is required.',
        }),
        {
          status: 401,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
        },
      })
    }

    if (!authHeader.startsWith('Bearer ')) {
      return new Response(
        JSON.stringify({
          error:
            'Invalid Authorization header.',
        }),
        {
          status: 401,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * Create an admin client.
     *
     * We use this for secure server-side database
     * operations.
     */
    const adminSupabase = createClient(
      supabaseUrl,
      serviceRoleKey
    )

    /*
     * Create a user-authenticated client.
     *
     * This allows auth.uid() inside the RPC
     * to represent the actual logged-in worker.
     */
    const userSupabase = createClient(
      supabaseUrl,
      serviceRoleKey,
      {
        global: {
          headers: {
            Authorization: authHeader,
          },
        },
      }
    )

    /*
     * ---------------------------------------------------------
     * VERIFY LOGGED-IN USER
     * ---------------------------------------------------------
     */

    const {
      data: {
        user,
      },
      error: userError,
    } = await userSupabase.auth.getUser()

    if (userError || !user) {
      console.error(
        '[verify-booking-otp] Auth error:',
        userError
      )

      return new Response(
        JSON.stringify({
          error:
            'Your session is invalid or expired. Please log in again.',
        }),
        {
          status: 401,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    const workerId = user.id

    /*
     * ---------------------------------------------------------
     * READ REQUEST
     * ---------------------------------------------------------
     */

    let body: {
      bookingId?: string
      otp?: string
      otpType?: 'start' | 'end'
    }

    try {
      body = await req.json()
    } catch {
      return new Response(
        JSON.stringify({
          error: 'Invalid JSON request body.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    const bookingId = body.bookingId
    const otp = body.otp
    const otpType = body.otpType

    /*
     * ---------------------------------------------------------
     * VALIDATE INPUT
     * ---------------------------------------------------------
     */

    if (!bookingId) {
      return new Response(
        JSON.stringify({
          error: 'bookingId is required.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    if (!otp) {
      return new Response(
        JSON.stringify({
          error: 'OTP is required.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    if (
      otpType !== 'start' &&
      otpType !== 'end'
    ) {
      return new Response(
        JSON.stringify({
          error:
            'otpType must be "start" or "end".',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * OTP should normally be 4-6 digits.
     */
    const cleanOtp = String(otp).trim()

    if (!/^\d{4,6}$/.test(cleanOtp)) {
      return new Response(
        JSON.stringify({
          error:
            'OTP must contain only 4 to 6 digits.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * GET BOOKING
     * ---------------------------------------------------------
     */

    const {
      data: booking,
      error: bookingError,
    } = await adminSupabase
      .from('bookings')
      .select(`
        id,
        worker_id,
        status
      `)
      .eq('id', bookingId)
      .maybeSingle()

    if (bookingError) {
      console.error(
        '[verify-booking-otp] Booking query error:',
        bookingError
      )

      return new Response(
        JSON.stringify({
          error:
            'Unable to find the booking.',
          details: bookingError.message,
        }),
        {
          status: 500,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    if (!booking) {
      return new Response(
        JSON.stringify({
          error: 'Booking not found.',
        }),
        {
          status: 404,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * VERIFY WORKER ASSIGNMENT
     * ---------------------------------------------------------
     */

    if (!booking.worker_id) {
      return new Response(
        JSON.stringify({
          error:
            'No worker is assigned to this booking.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    if (booking.worker_id !== workerId) {
      console.error(
        '[verify-booking-otp] Worker mismatch:',
        {
          bookingWorker:
            booking.worker_id,
          loggedInWorker:
            workerId,
        }
      )

      return new Response(
        JSON.stringify({
          error:
            'You are not assigned to this booking.',
        }),
        {
          status: 403,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * VERIFY BOOKING STATUS
     * ---------------------------------------------------------
     *
     * Start OTP:
     *
     * arrived -> in_progress
     *
     * End OTP:
     *
     * in_progress -> completed
     */

    if (
      otpType === 'start' &&
      booking.status !== 'arrived'
    ) {
      return new Response(
        JSON.stringify({
          error:
            `Start OTP cannot be used when booking status is "${booking.status}".`,
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    if (
      otpType === 'end' &&
      booking.status !== 'in_progress'
    ) {
      return new Response(
        JSON.stringify({
          error:
            `End OTP cannot be used when booking status is "${booking.status}".`,
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * GET ACTIVE OTP
     * ---------------------------------------------------------
     */

    const {
      data: otpRecord,
      error: otpError,
    } = await adminSupabase
      .from('booking_otps')
      .select(`
        id,
        booking_id,
        otp_type,
        otp_hash,
        attempts,
        expires_at,
        status,
        created_at
      `)
      .eq('booking_id', bookingId)
      .eq('otp_type', otpType)
      .eq('status', 'pending')
      .order('created_at', {
        ascending: false,
      })
      .limit(1)
      .maybeSingle()

    if (otpError) {
      console.error(
        '[verify-booking-otp] OTP query error:',
        otpError
      )

      return new Response(
        JSON.stringify({
          error:
            'Unable to verify OTP.',
          details: otpError.message,
        }),
        {
          status: 500,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    if (!otpRecord) {
      return new Response(
        JSON.stringify({
          error:
            'No active OTP found. Please request a new OTP.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * CHECK EXPIRATION
     * ---------------------------------------------------------
     */

    if (
      otpRecord.expires_at &&
      new Date(
        otpRecord.expires_at
      ).getTime() <= Date.now()
    ) {
      await adminSupabase
        .from('booking_otps')
        .update({
          status: 'expired',
        })
        .eq('id', otpRecord.id)

      return new Response(
        JSON.stringify({
          error:
            'OTP has expired. Please request a new OTP.',
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * CHECK ATTEMPTS
     * ---------------------------------------------------------
     */

    const attempts =
      Number(otpRecord.attempts || 0)

    if (attempts >= 5) {
      await adminSupabase
        .from('booking_otps')
        .update({
          status: 'blocked',
        })
        .eq('id', otpRecord.id)

      return new Response(
        JSON.stringify({
          error:
            'Too many incorrect OTP attempts. Please request a new OTP.',
        }),
        {
          status: 429,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * HASH SUPPLIED OTP
     * ---------------------------------------------------------
     */

    const suppliedHash =
      await sha256(cleanOtp)

    /*
     * ---------------------------------------------------------
     * COMPARE OTP
     * ---------------------------------------------------------
     */

    if (
      suppliedHash !== otpRecord.otp_hash
    ) {
      const newAttempts = attempts + 1

      const newStatus =
        newAttempts >= 5
          ? 'blocked'
          : 'pending'

      await adminSupabase
        .from('booking_otps')
        .update({
          attempts: newAttempts,
          status: newStatus,
        })
        .eq('id', otpRecord.id)

      console.warn(
        '[verify-booking-otp] Invalid OTP:',
        {
          bookingId,
          otpType,
          workerId,
          attempts: newAttempts,
        }
      )

      return new Response(
        JSON.stringify({
          error:
            newAttempts >= 5
              ? 'Too many incorrect OTP attempts. Please request a new OTP.'
              : 'Invalid OTP.',
          attemptsRemaining:
            Math.max(0, 5 - newAttempts),
        }),
        {
          status:
            newAttempts >= 5
              ? 429
              : 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * DETERMINE NEXT STATUS
     * ---------------------------------------------------------
     */

    const nextStatus =
      otpType === 'start'
        ? 'in_progress'
        : 'completed'

    /*
     * ---------------------------------------------------------
     * UPDATE BOOKING USING RPC
     * ---------------------------------------------------------
     *
     * IMPORTANT:
     *
     * We do NOT directly update bookings.
     *
     * The existing RPC also updates worker availability.
     */

    const {
      data: updatedBooking,
      error: statusError,
    } = await userSupabase.rpc(
      'update_worker_booking_status',
      {
        p_booking_id: bookingId,
        p_status: nextStatus,
      }
    )

    if (statusError) {
      console.error(
        '[verify-booking-otp] RPC error:',
        {
          message:
            statusError.message,
          details:
            statusError.details,
          hint:
            statusError.hint,
          code:
            statusError.code,
        }
      )

      return new Response(
        JSON.stringify({
          error:
            'Unable to update booking status.',
          details:
            statusError.message,
          code:
            statusError.code,
        }),
        {
          status: 400,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * MARK OTP VERIFIED
     * ---------------------------------------------------------
     */

    const {
      error: otpUpdateError,
    } = await adminSupabase
      .from('booking_otps')
      .update({
        status: 'verified',
        verified_at:
          new Date().toISOString(),
      })
      .eq('id', otpRecord.id)
      .eq('status', 'pending')

    if (otpUpdateError) {
      console.error(
        '[verify-booking-otp] OTP update error:',
        otpUpdateError
      )

      /*
       * Booking was already successfully changed.
       *
       * Do not change booking back here.
       * Log the OTP update problem for investigation.
       */
      return new Response(
        JSON.stringify({
          success: true,
          bookingId,
          otpType,
          status: nextStatus,
          warning:
            'Booking was updated successfully, but OTP record could not be marked verified.',
        }),
        {
          status: 200,
          headers: {
            ...corsHeaders,
            'Content-Type':
              'application/json',
          },
        }
      )
    }

    /*
     * ---------------------------------------------------------
     * SUCCESS
     * ---------------------------------------------------------
     */

    console.log(
      '[verify-booking-otp] Success:',
      {
        bookingId,
        otpType,
        workerId,
        previousStatus:
          booking.status,
        nextStatus,
      }
    )

    return new Response(
      JSON.stringify({
        success: true,
        bookingId,
        otpType,
        status: nextStatus,
        booking:
          updatedBooking || null,
      }),
      {
        status: 200,
        headers: {
          ...corsHeaders,
          'Content-Type':
            'application/json',
        },
      }
    )
  } catch (error) {
    console.error(
      '[verify-booking-otp] Unexpected error:',
      error
    )

    return new Response(
      JSON.stringify({
        error:
          error instanceof Error
            ? error.message
            : 'Internal server error',
      }),
      {
        status: 500,
        headers: {
          ...corsHeaders,
          'Content-Type':
            'application/json',
        },
      }
    )
  }
})